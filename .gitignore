# Third-party datasheet PDFs are kept locally, not in git (see documentation/datasheets/README.md)
documentation/datasheets/**/*.pdf

# LibreOffice lock files
.~lock.*#

# KiCad generated files
hardware/kicad/*-backups/
hardware/kicad/*.kicad_prl
hardware/kicad/fp-info-cache
hardware/kicad/_autosave-*
hardware/kicad/*.lck

# Python caches
__pycache__/
*.pyc
